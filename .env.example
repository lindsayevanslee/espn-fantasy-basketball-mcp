# Optional. scripts/verify_live.py reads these from your Claude Desktop config automatically;
# use this file only if you prefer not to rely on that.
# Copy to .env (gitignored) and fill in. Load with:  set -a; source .env; set +a
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
# Private leagues only. These cookies grant full access to your ESPN account; never commit them.
ESPN_S2=
ESPN_SWID=
# Optional. ESPN labels a season by the year it ends in (2026-27 -> 2027). Leave blank to auto-detect.
ESPN_YEAR=
# Optional IANA timezone for game times and dates. Default: America/New_York
MY_TIMEZONE=

# Only for serving the tools over HTTP (claude.ai / Claude mobile app custom connector).
# Leave unset for Claude Desktop. See README "Using the server from the Claude mobile app".
# MCP_TRANSPORT=streamable-http
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=
