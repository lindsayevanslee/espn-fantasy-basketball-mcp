# Copy to .env (gitignored) and fill in. Load with:  set -a; source .env; set +a
# Then run:  uv run python scripts/verify_live.py
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
# Private leagues only. These cookies grant full access to your ESPN account; never commit them.
ESPN_S2=
ESPN_SWID=
# Optional. ESPN labels a season by the year it ends in (2026-27 -> 2027). Leave blank to auto-detect.
ESPN_YEAR=
# Optional IANA timezone for game times and dates. Default: America/New_York
MY_TIMEZONE=
